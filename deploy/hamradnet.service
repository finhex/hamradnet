# Client daemon, for a Linux machine that should join its networks at boot.
#
#   sudo cp hamradnet /usr/local/bin/
#   sudo hamradnet up --server YOUR.SERVER:7777 --name yourname   # once, to set up
#   sudo cp deploy/hamradnet.service /etc/systemd/system/
#   sudo systemctl enable --now hamradnet
#
# Runs as root: creating the tunnel interface needs CAP_NET_ADMIN.
[Unit]
Description=HamRadNet virtual LAN client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/hamradnet up
Environment=RUST_LOG=hamradnet=info
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
